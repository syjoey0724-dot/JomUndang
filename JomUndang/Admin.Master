<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="JomUndang.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JomUndang - Admin Panel</title>
  <link href="~/style.css?v=3" rel="stylesheet" runat="server" />
  <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
  <form id="form1" runat="server">

    <!-- Header -->
    <header>
      <div class="logo-row">
        <a runat="server" href="~/AdminDashboard.aspx">
          <img src="~/logo.png" alt="JomUndang Logo" runat="server" />
        </a>
      </div>

      <nav id="mainNav">
        <!-- Mobile Menu -->
        <button type="button" id="menuToggle" class="menu-toggle">&#9776; Menu</button>

        <!-- Admin Menu -->
        <ul class="menu">
          <li class="dropdown">
            <a href="AdminDashboard.aspx" class="menu-title" style="text-decoration: none;">Dashboard</a>
          </li>
          <li class="dropdown">
            <a href="ManageQuestions.aspx" class="menu-title" style="text-decoration: none;">Manage Questions</a>
          </li>
          <li class="dropdown">
            <a href="ManageTests.aspx" class="menu-title" style="text-decoration: none;">Manage Tests</a>
          </li>
        </ul>

        <!-- Authentication -->
        <asp:LoginView ID="LoginView1" runat="server">
          
          <AnonymousTemplate>
            <div class="dropdown dropdown-right">
              <span class="small-btn" tabindex="0">Login</span>
              <div class="dropdown-content">
                <a runat="server" href="~/Login.aspx">Login Now</a>
              </div>
            </div>
          </AnonymousTemplate>
          
          <LoggedInTemplate>
            <div class="dropdown dropdown-right">
              <!-- Profile Image -->
              <img src="ProfileLogo.png" alt="Profile" tabindex="0" style="width: 45px; height: 45px; object-fit: contain; background-color: transparent; border: none; cursor: pointer; display: block;" />
              
              <div class="dropdown-content">
                <!-- Dashboard Link -->
                <a runat="server" href="~/AdminDashboard.aspx">Admin Dashboard</a>
                
                <!-- Logout -->
                <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CausesValidation="false">Logout</asp:LinkButton>
              </div>
            </div>
          </LoggedInTemplate>
          
        </asp:LoginView>
        
      </nav>
    </header>

    <!-- Main Content -->
    <main>
      <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
    </main>

    <!-- Footer -->
    <footer>
      <div class="footer-grid">
        
        <!-- Admin Links -->
        <div class="footer-section">
          <h4>Admin Panel</h4>
          <div class="footer-links">
            <a runat="server" href="~/AdminDashboard.aspx">Dashboard</a>
            <a runat="server" href="~/ManageQuestions.aspx">Manage Questions</a>
            <a runat="server" href="~/ManageTests.aspx">Manage Tests</a>
          </div>
        </div>

        <!-- System Actions -->
        <div class="footer-section">
          <h4>System Actions</h4>
          <div class="footer-links">
            <a runat="server" href="~/AdminDashboard.aspx">Pending Approvals</a>
            <a href="#" onclick="alert('Logout from top right menu.'); return false;">Logout</a>
          </div>
        </div>

        <!-- Support -->
        <div class="footer-section">
          <h4>Support</h4>
          <div class="footer-links">
            <a href="mailto:jomundang@apu.edu.my">Contact Support</a>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="footer-section">
          <p class="footer-info">
            <strong>Email</strong><br>
            <a href="mailto:jomundang@apu.edu.my">jomundang@apu.edu.my</a>
          </p>
          <p class="footer-info">
            <strong>Address</strong><br>
            No. 11, Jalan Teknologi 5, Taman Teknologi Malaysia, Bukit Jalil, 57000 Kuala Lumpur, Wilayah Persekutuan Kuala Lumpur, Malaysia
          </p>
          <!-- Map -->
          <div class="footer-map">
            <iframe src="https://www.google.com/maps?q=Asia+Pacific+University+of+Technology+and+Innovation+Bukit+Jalil&output=embed" title="Map" loading="lazy"></iframe>
            <a href="https://www.google.com/maps/search/?api=1&query=Asia+Pacific+University+of+Technology+and+Innovation+Bukit+Jalil" target="_blank" rel="noopener">Open in Google Maps</a>
          </div>
        </div>

      </div>

      <!-- Copyright -->
      <div class="footer-bottom">
        <div>&copy; 2026 JomUndang Admin. All rights reserved.</div>
      </div>
    </footer>

  </form>

  <!-- Mobile Script -->
  <script>
    document.getElementById("menuToggle").onclick = function () {
      document.getElementById("mainNav").classList.toggle("open");
    };
  </script>
</body>
</html>